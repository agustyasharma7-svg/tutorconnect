# TutorConnect API — sample env (NestJS)
# Copy this file to: api/.env
#   copy api\.env.example api\.env
#
# Restart the API after changes: npm run dev
# Never commit api/.env — it contains secrets.

# -----------------------------------------------------------------------------
# Database (Docker Compose maps Postgres to host port 5433)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://tutorconnect:tutorconnect@localhost:5433/tutorconnect?schema=public

# -----------------------------------------------------------------------------
# Redis (OTP, BullMQ email queue, session-reminder dedupe)
#
# Local: redis://localhost:6379 (Compose publishes 6379 for DX only)
# Staging/prod: use requirepass and do NOT publish Redis to the internet.
#   Example: REDIS_URL=redis://:YOUR_STRONG_PASSWORD@127.0.0.1:6379
#   Compose: command: redis-server --requirepass YOUR_STRONG_PASSWORD
#   Bind privately (Docker network only; no host port mapping).
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# JWT
# Use long random strings in real environments (min ~32 chars).
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# SMTP — email OTP + notifications (Gmail App Password recommended for local)
# 1. Enable 2-Step Verification
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Put the 16-char password in SMTP_PASS (no spaces)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=TutorConnect <your-gmail@gmail.com>

# OTP TTL (seconds)
OTP_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Cloudinary — tutor photos + agreement/invoice PDFs
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -----------------------------------------------------------------------------
# Razorpay — server (tutor fees only: registration + commission)
#
# PAYMENTS_MOCK:
#   true  = no Razorpay orders; FE uses POST /payments/mock-complete (local/dev default)
#   false = create real Razorpay orders (test or live keys) — requires valid RAZORPAY_*
# Boot hard-fails if PAYMENTS_MOCK=true and NODE_ENV=production.
#
# Local DX: leave true. For Razorpay TEST MODE: PAYMENTS_MOCK=false + rzp_test_* keys.
# Webhook secret optional locally; set for production webhook signature verify
# -----------------------------------------------------------------------------
PAYMENTS_MOCK=true
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# PII encryption (document numbers for Aadhaar/PAN)
# 32-byte hex (64 chars) or base64, or any passphrase (scrypt-derived)
# REQUIRED when NODE_ENV=production (API will not boot without it).
# Leave empty only in local/dev to store last-4 without ciphertext.
# -----------------------------------------------------------------------------
DOCUMENT_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------
API_PORT=3001
# Comma-separated. Required when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Admin seed (npm run prisma:seed)
# In production, ADMIN_PASSWORD must be set and must NOT be Admin@123456.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@tutorconnect.in
ADMIN_PASSWORD=Admin@123456
ADMIN_MOBILE=9999999999

# -----------------------------------------------------------------------------
# Sentry (optional locally; recommended for staging/prod — Phase 7B.5)
# Leave empty to disable. Create a project at https://sentry.io
# -----------------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Google Maps Geocoding (optional)
# When set, pincode → lat/lng uses Google Geocoding API (components=postal_code|country:IN).
# When empty, falls back to deterministic stub (local DX only — distances are not accurate).
# Client-provided lat/lng always win when within India bounds.
# Enable Geocoding API on the Google Cloud project for this key.
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Soft launch invite gate (Phase 7D.3)
# When true, new registration requires inviteCode matching SOFT_LAUNCH_INVITE_CODES
# OR email in SOFT_LAUNCH_ALLOWLIST_EMAILS. Existing users can still log in.
# -----------------------------------------------------------------------------
SOFT_LAUNCH_INVITE_ONLY=false
SOFT_LAUNCH_INVITE_CODES=
SOFT_LAUNCH_ALLOWLIST_EMAILS=

# Support contact (also set NEXT_PUBLIC_SUPPORT_EMAIL on web)
# SUPPORT_EMAIL=support@tutorconnect.in
