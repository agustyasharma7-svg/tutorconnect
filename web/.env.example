# TutorConnect Web — sample env (Next.js)
# Copy this file to: web/.env.local
#   copy web\.env.example web\.env.local
#
# Only NEXT_PUBLIC_* vars are needed for the browser app.
# Do NOT put secrets (API keys secrets, SMTP passwords, JWT) here —
# those belong in api/.env only.
#
# After changing .env.local, restart: npm run dev

# -----------------------------------------------------------------------------
# API base URL (required)
# Must match the Nest API global prefix: http://host:port/api/v1
# Locally the Next app proxies /api/v1 → this origin so auth cookies stay first-party.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# -----------------------------------------------------------------------------
# Razorpay — client (publishable / Key ID only)
#
# PAYMENTS_MOCK:
#   true  = skip Razorpay UI; checkout follows API order.mock (local/dev default)
#   false = expect real Razorpay Checkout when API returns mock:false
#
# Must mirror api/.env PAYMENTS_MOCK. Checkout uses the API `mock` flag as source of truth.
# For Razorpay TEST MODE: set both sides false and use rzp_test_... Key ID
#
# Key Secret stays on the API only (never put RAZORPAY_KEY_SECRET in web).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PAYMENTS_MOCK=true
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# -----------------------------------------------------------------------------
# Site URL (SEO sitemap / robots / metadataBase) — Phase 7C.4
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Soft launch: show required invite field on register (mirror API SOFT_LAUNCH_INVITE_ONLY)
NEXT_PUBLIC_SOFT_LAUNCH_INVITE_ONLY=false

# GET response cache TTL (ms). Identical in-flight GETs are deduped within this window.
NEXT_PUBLIC_API_CACHE_TTL_MS=30000

# Published on legal pages
NEXT_PUBLIC_SUPPORT_EMAIL=support@tutorconnect.in

# -----------------------------------------------------------------------------
# Sentry (optional locally; recommended for staging/prod — Phase 7B.5)
# Browser/client DSN (safe to expose as NEXT_PUBLIC_*).
# Optional server-only SENTRY_DSN can override on the Node runtime.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
