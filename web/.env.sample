# Alias of web/.env.example — same content.
# Prefer copying web/.env.example → web/.env.local
#
# See web/.env.example for full comments.
# Mirror api/.env PAYMENTS_MOCK and SOFT_LAUNCH_INVITE_ONLY on the NEXT_PUBLIC_* twins.

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_PAYMENTS_MOCK=true
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SOFT_LAUNCH_INVITE_ONLY=false
